#!/bin/bash
# Generated by `ctsynth prepare` for bundle {bundle_id} (commit {git_commit}).
# Plain str.format template (despite the .j2 name, no Jinja). Lines starting with
# "# TODO(unset)" are fields the bundle did not specify: a human must fill them in.
{sbatch_lines}
set -u
{scratch_line}
BUNDLE_DIR="${{SLURM_SUBMIT_DIR:-$PWD}}"
OUT="${{SCRATCH_DIR:-$BUNDLE_DIR/result}}/{bundle_id}"
mkdir -p "$OUT"
# Pinned source checkout (runbook step 3): the entry point is relative to it.
: "${{CTSYNTH_SRC_ROOT:?set CTSYNTH_SRC_ROOT to the pinned checkout of {git_commit}}}"
cd "$CTSYNTH_SRC_ROOT"
# --- environment setup (from bundle config; never inherited silently) ---
{env_setup}
# --- pinned entry point ---
START="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
{entry} > "$OUT/stdout.log" 2> "$OUT/stderr.log"
RC=$?
ctsynth export --bundle "$BUNDLE_DIR" --out "$OUT" --exit-code "$RC" \
  --started "$START" --ended "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --slurm-job "${{SLURM_JOB_ID:-}}"
exit "$RC"
